# Copy to .env and fill in. Never commit .env.

# Leave unset to use the mongodb container in compose.yml.
# For Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# Shared secret between the Node APIs and ml-service. Any long random string.
AI_SERVICE_API_KEY=change-me

# Auth0 tenant
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.tapiro.local
# Single Page Application used by web/
AUTH0_SPA_CLIENT_ID=
# Machine to Machine application with Management API access
# (read:users update:users create:users)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# Role IDs from Auth0 > User Management > Roles
AUTH0_USER_ROLE_ID=
AUTH0_STORE_ROLE_ID=

# Not read by the code yet, passed through by compose.yml
AUTH0_TOKEN_URL=
AUTH0_AUTHORIZE_URL=
AUTH0_MANAGEMENT_API_TOKEN=
