FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./

FROM base AS deps
RUN --mount=type=cache,target=/root/.npm \
    npm install

FROM deps AS development
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]

FROM deps AS build
# Vite bakes VITE_ variables into the bundle at build time
ARG VITE_API_URL
ARG VITE_AUTH0_DOMAIN
ARG VITE_AUTH0_CLIENT_ID
ARG VITE_AUTH0_AUDIENCE
ARG VITE_DEMO_USER_EMAIL
ARG VITE_DEMO_USER_PASSWORD
ARG VITE_DEMO_STORE_EMAIL
ARG VITE_DEMO_STORE_PASSWORD
ENV VITE_API_URL=$VITE_API_URL \
    VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN \
    VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID \
    VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE \
    VITE_DEMO_USER_EMAIL=$VITE_DEMO_USER_EMAIL \
    VITE_DEMO_USER_PASSWORD=$VITE_DEMO_USER_PASSWORD \
    VITE_DEMO_STORE_EMAIL=$VITE_DEMO_STORE_EMAIL \
    VITE_DEMO_STORE_PASSWORD=$VITE_DEMO_STORE_PASSWORD
COPY . .
RUN --mount=type=cache,target=/root/.npm \
    npm run build

FROM nginx:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
