# Use an official Node runtime as a parent image
FROM node:20-alpine AS base

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json (or yarn.lock if you use yarn)
COPY package*.json ./

# --- Dependencies Stage ---
# Install dependencies separately to leverage Docker cache
FROM base AS deps
RUN npm install

# --- Development Stage ---
FROM deps AS development

# Copy the rest of the application code
COPY . .

# Make port 5173 available to the world outside this container
EXPOSE 5173

# Run the app when the container launches in development mode
# Use --host to expose the server to the network, required for Docker
CMD ["npm", "run", "dev", "--", "--host"]

# --- Build Stage ---
FROM deps AS build

# Copy the rest of the application code
COPY . .

# Build the application
# The `tsc -b` part is handled by the build script in package.json
RUN npm run build

# --- Production Stage ---
# Use a smaller image to serve the static files
FROM nginx:alpine AS production

# Copy the built assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config if you have a custom one (optional)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80 for nginx
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]